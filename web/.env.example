# Copy to .env.local for local development (`npm run dev`), or set these in Vercel.
# Server side (api/relay.ts): the relayer pays network fees, it can never move invoice money.
NETWORK=testnet
PAYPACT_TOKEN=tusdcwer0a.paypact-dev-mwaweex6.testnet
RELAYER_ACCOUNT_ID=your-relayer.testnet
RELAYER_PRIVATE_KEY=ed25519:...
# Mainnet only: PAYPACT_CONTRACT=<your contract>.near
# Optional on testnet: PAYPACT_CONTRACT_OVERRIDE=<your contract>.testnet

# Browser side (Vite). Defaults to testnet and the deployed contract below.
# VITE_NETWORK=testnet
# VITE_CONTRACT=pact2.paypact-dev-mwaweex6.testnet
# VITE_TOKEN=tusdcwer0a.paypact-dev-mwaweex6.testnet
# Mainnet revenue: fee on any-crypto payments, collected by NEAR Intents (basis points).
# VITE_APP_FEE_RECIPIENT=<your account>.near
# VITE_APP_FEE_BPS=50
